# Self Search configuration
# Copy this file to .env and edit as needed.
# Never commit .env to version control.

# === Paths ===
SHELFSENSE_DB_PATH=data/processed/shelfsense.db
SHELFSENSE_DATA_RAW_DIR=data/raw
SHELFSENSE_DATA_PROCESSED_DIR=data/processed
SHELFSENSE_MODELS_DIR=models
# Directory with products.index, reviews.index and manifest.json. The API refuses to
# start if manifest.json is missing or does not match the database (see docs/deployment.md).
# SHELFSENSE_VECTOR_STORE_DIR=data/vector_store

# === Logging ===
SHELFSENSE_LOG_LEVEL=INFO
SHELFSENSE_LOG_FORMAT=json
# Options: json, console

# === LLM (local Ollama) ===
# SHELFSENSE_OLLAMA_BASE_URL=http://localhost:11434
# Must match a name from `ollama list` exactly.
# SHELFSENSE_OLLAMA_MODEL=llama3.2:3b
# Model-time budget per chat message (parsing + answer + retries). When it runs out the
# answer uses the safe evidence-based fallback. Keep it below the UI's 120 s timeout.
# SHELFSENSE_OLLAMA_TIMEOUT=110
# Query understanding: rules_first (default; the LLM only for brand cues such as
# "from Sony") or llm_first (the LLM parses every message; one extra model call per turn).
# SHELFSENSE_QUERY_PARSER_MODE=rules_first

# === Embeddings ===
# The FAISS indexes are built with the offline 64-d embedder. Ollama embeddings are used
# only with SHELFSENSE_EMBEDDING_BACKEND=ollama, which also needs an Ollama *embedding*
# model (EMBEDDING_MODEL), rebuilt indexes and re-checked validation thresholds.
# SHELFSENSE_EMBEDDING_BACKEND=offline
# SHELFSENSE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# === Retrieval (configured in later phases) ===
# SHELFSENSE_RETRIEVAL_MODE=hybrid
# Options: semantic, keyword, hybrid, reranked_hybrid
# SHELFSENSE_RETRIEVAL_TOP_K=10

# === Server (configured in later phases) ===
# SHELFSENSE_API_HOST=127.0.0.1
# SHELFSENSE_API_PORT=8000

# === Privacy ===
SHELFSENSE_LOAD_REMOTE_IMAGES=true

# === Synthetic INR price estimates (experimental) ===
# Off by default. Estimates are illustrative, never retailer prices (docs/data-sources.md).
# SHELFSENSE_ESTIMATED_PRICES_ENABLED=false
# SHELFSENSE_PRICE_ESTIMATE_CONFIG=config/price_estimate_ranges.toml
